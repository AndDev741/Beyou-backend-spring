# Database
DATABASE_URL=jdbc:postgresql://localhost:5490/beyou
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# Auth
TOKEN_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Allowed audiences for mobile Google ID tokens (comma-separated); defaults to GOOGLE_CLIENT_ID.
# Add the Android/iOS OAuth client ids here once provisioned.
GOOGLE_MOBILE_AUDIENCES=

# URLs
FRONTEND_URL=http://localhost:3000/
OAUTH_GOOGLE_URL=https://oauth2.googleapis.com/token
USER_INFO_GOOGLE_URL=https://www.googleapis.com/oauth2/v2/userinfo

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# CORS
CORS_ALLOWED_PATTERN=*

# Mail
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_MINUTES=5

LLM_CHAIN_ORDER=mistral,gemini,openrouter,deepseek
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional model overrides: MISTRAL_MODEL, GEMINI_MODEL, OPENROUTER_MODEL
# Optional cooldowns (seconds): LLM_COOLDOWN_RATELIMIT=300, LLM_COOLDOWN_ERROR=30

# Docs Import
DOCS_IMPORT_REPO_OWNER=AndDev741
DOCS_IMPORT_REPO_NAME=beyou-arch-design
DOCS_IMPORT_PATH=architecture
DOCS_IMPORT_PROJECTS_PATH=projects
DOCS_IMPORT_API_PATH=api
DOCS_IMPORT_TOKEN=
DOCS_IMPORT_SECRET=

# Monitoring
MANAGEMENT_PORT=9091
ACTUATOR_ENDPOINTS=health,metrics,prometheus

# Error telemetry (GlitchTip — self-hosted, Sentry-API compatible)
# Leave SENTRY_DSN empty to disable error reporting completely: with no DSN the
# Sentry autoconfiguration never engages and no Sentry bean is created. Get the
# value from the GlitchTip UI under Settings -> Projects -> beyou-backend ->
# Client Keys (DSN). See Beyou-dev-env/README.md for first-run setup.
SENTRY_DSN=
# Ties reported events to the build they came from. CI publishes backend images
# tagged sha-<short sha> — pass the matching identifier, e.g.
# SENTRY_RELEASE=beyou-backend@sha-1a2b3c4. Defaults to beyou-backend@local.
SENTRY_RELEASE=
# Groups events by deployment: local, staging, prod. Defaults to "local".
SENTRY_ENVIRONMENT=

# Spring Profile (dev or prod)
SPRING_PROFILES_ACTIVE=dev
