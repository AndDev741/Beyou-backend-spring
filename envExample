# Error telemetry (GlitchTip — self-hosted, Sentry-API compatible)
# Leave SENTRY_DSN empty to disable error reporting completely: with no DSN the
# Sentry autoconfiguration never engages and no Sentry bean is created. Get the
# value from the GlitchTip UI under Settings -> Projects -> beyou-backend ->
# Client Keys (DSN). See Beyou-dev-env/README.md for first-run setup.
SENTRY_DSN=
# Ties reported events to the build they came from. CI publishes backend images
# tagged sha-<short sha> — pass the matching identifier, e.g.
# SENTRY_RELEASE=beyou-backend@sha-1a2b3c4. Defaults to beyou-backend@local.
SENTRY_RELEASE=
# Groups events by deployment: local, staging, prod. Defaults to "local".
SENTRY_ENVIRONMENT=
# With a DSN set, the Logback integration is also on (see `sentry.logging` in
# application.yaml): ERROR log lines become events of their own — which is how failures
# that code catches and logs itself, such as a failed async e-mail send, become visible —
# and INFO+ lines become breadcrumbs attached to the next captured event. Loggers whose
# lines carry user content or a third-party response body are excluded in
# config/SentryLoggerExclusions.
# No variable is needed to switch this on. To switch it OFF for one deployment without a
# rebuild, uncomment the line below — environment variables outrank application.yaml.
# Leave it commented rather than empty: an empty value binds as `false`.
# SENTRY_LOGGING_ENABLED=false

# Heartbeat for the scheduled snapshot job (RoutineSnapshotScheduler).
# The job runs hourly and checks in here after every completed cycle; GlitchTip
# alerts when a check-in fails to ARRIVE, which is the only way to detect that the
# cron stopped firing (health checks stay green when a scheduler thread wedges).
# Leave empty to disable — nothing outbound is attempted without it.
# Create the monitor in GlitchTip under Uptime Monitors -> New Monitor, type
# "Heartbeat", expected interval 5400s. Copy the endpoint URL it gives you, e.g.
# SNAPSHOT_HEARTBEAT_URL=http://glitchtip:8000/api/<org-slug>/heartbeat/<uuid>/
# Use the in-network host (http://glitchtip:8000) when the backend runs in the
# compose stack. See Beyou-dev-env/README.md.
SNAPSHOT_HEARTBEAT_URL=

# Spring Profile (dev or prod)
SPRING_PROFILES_ACTIVE=dev
